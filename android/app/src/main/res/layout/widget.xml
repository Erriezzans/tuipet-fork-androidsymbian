<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <FrameLayout android:layout_width="180dp" android:layout_height="180dp"
      android:layout_gravity="center" android:background="@drawable/digivice_body">
    <TextView android:id="@+id/b_feed" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="5dp" android:layout_marginTop="84dp"
        android:gravity="center" android:text="F" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="@drawable/btn_bg"/>
    <ViewFlipper android:id="@+id/lcd" android:layout_width="66dp" android:layout_height="66dp"
        android:layout_marginStart="57dp" android:layout_marginTop="61dp"
        android:background="@drawable/lcd_bg" android:padding="4dp"
        android:autoStart="true" android:flipInterval="600">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/baby_a" android:id="@+id/f1"/>
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/baby_b" android:id="@+id/f2"/>
    </ViewFlipper>
    <TextView android:id="@+id/b_play" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginStart="140dp" android:layout_marginTop="62dp"
        android:gravity="center" android:text="P" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="@drawable/btn_bg"/>
    <TextView android:id="@+id/b_heal" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginStart="140dp" android:layout_marginTop="105dp"
        android:gravity="center" android:text="H" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="@drawable/btn_bg"/>
    <TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="14dp"
        android:layout_marginTop="153dp" android:gravity="center"
        android:textSize="9sp" android:textColor="#1B2A44"/>
  </FrameLayout>
</FrameLayout>

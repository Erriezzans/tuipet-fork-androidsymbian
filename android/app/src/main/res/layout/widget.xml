<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center"
    android:padding="10dp" android:background="@drawable/digivice_body">
  <TextView android:id="@+id/b_feed" android:layout_width="46dp" android:layout_height="46dp"
      android:gravity="center" android:text="F" android:textColor="#FFFFFF"
      android:textStyle="bold" android:background="@drawable/btn_bg"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
      android:layout_weight="1" android:orientation="vertical" android:gravity="center"
      android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
    <ViewFlipper android:id="@+id/lcd" android:layout_width="76dp" android:layout_height="76dp"
        android:background="@drawable/lcd_bg" android:padding="6dp"
        android:autoStart="true" android:flipInterval="600">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sprite_a"/>
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sprite_b"/>
    </ViewFlipper>
    <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="#1B2A44"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/b_play" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:text="P" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="@drawable/btn_bg"/>
    <TextView android:id="@+id/b_heal" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginTop="8dp" android:gravity="center" android:text="H"
        android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/btn_bg"/>
  </LinearLayout>
</LinearLayout>
